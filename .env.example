POSTGRES_DB=gitsense
POSTGRES_USER=gitsense
POSTGRES_PASSWORD=gitsense

DATABASE_URL=postgresql+asyncpg://gitsense:gitsense@postgres:5432/gitsense
REDIS_URL=redis://redis:6379/0

# Generate a random secret
SESSION_SECRET=your_random_secret

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

FRONTEND_URL=http://localhost:3000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenRouter / OpenAI-compatible API
OPENAI_API_KEY=your_openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_HTTP_REFERER=http://localhost:3000
OPENAI_TITLE=GitSense

AI_PROVIDER=openai

AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.5

ENABLE_RATE_LIMITING=false

NEXT_PUBLIC_API_URL=http://localhost:8000
